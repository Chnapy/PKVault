{
  "name": "pkvault-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "c:type": "tsgo -b",
    "c:type:classic": "tsc -b",
    "c:lint": "eslint .",
    "c:lint:css": "stylelint src/**/*.css",
    "c:spell": "cspell . ../docs --no-progress",
    "gen:routes": "tsr generate",
    "gen:sdk": "cross-env VITE_OPENAPI_PATH=../PKVault.Core/swagger.json npm run gen:sdk:basic",
    "gen:sdk:basic": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 node ./generate-sdk.ts",
    "gen:css:dts": "vite-css-modules",
    "gen:docs": "node ./generate-docs.ts",
    "gen:cssvar": "node ./generate-cssvar.ts",
    "c:translate": "node ./parse-translations.ts",
    "c:translate:fix": "node ./parse-translations.ts --fix",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "knip": "knip"
  },
  "dependencies": {
    "@mantine/core": "^9.5.1",
    "@mantine/dropzone": "^9.5.2",
    "@mantine/hooks": "^9.5.1",
