<?xml version="1.0" encoding="utf-8"?>
<component type="desktop-application">
  <id>io.github.chnapy.pkvault</id>

  <!-- old ID used locally before flathub publish -->
  <replaces>
    <id>org.chnapy.pkvault</id>
  </replaces>
  <provides>
    <id>org.chnapy.pkvault</id>
  </provides>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <launchable type="desktop-id">io.github.chnapy.pkvault.desktop</launchable>

  <name>PKVault</name>
  <name xml:lang="fr">PKVault</name>
  <name xml:lang="de">PKVault</name>

  <summary>Pokémon hub for your games</summary>
  <summary xml:lang="fr">Hub Pokémon pour vos jeux</summary>
  <summary xml:lang="de">Pokémon-Zentrale für deine Spiele</summary>

  <description>
    <p>
      Centralize all your Pokémon games in one place.
      Manage storages between your saves, and group all Pokédex data.
    </p>
    <p xml:lang="fr">
      Regroupez tous vos jeux Pokémon au même endroit.
      Gérez les stockages entre vos sauvegardes, et centralisez les données Pokédex.
    </p>
    <p xml:lang="de">
      Führe all deine Pokémon-Spiele an einem Ort zusammen.
      Verwalte deine Speicherstände und führe alle Pokédex-Daten zusammen.
    </p>
  
    <ul>
      <li>Compatible with all generations, from first one to Pokémon Legends: Z-A</li>
      <li xml:lang="fr">Compatible avec toutes les générations, de la première à Pokémon Legends: Z-A</li>
      <li xml:lang="de">Kompatibel mit allen Generationen, von der ersten bis zu Pokémon-Legenden: Z-A</li>

      <li>Safely convert pokémons to any generation</li>
      <li xml:lang="fr">Convertissez les pokémons vers n'importe quelle génération, sans perte de donnée</li>
      <li xml:lang="de">Sichere Übertragung von Pokémon in jede beliebige Generation</li>

      <li>Edit pokémons nickname, moves and EVs</li>
      <li xml:lang="fr">Modifiez les pokémons: surnom, capacités et EVs</li>
      <li xml:lang="de">Bearbeitung von Spitznamen, Attacken und EVs</li>

      <li>Evolve pokémons requiring trade</li>
      <li xml:lang="fr">Evoluez les pokémons exigeant un échange</li>
      <li xml:lang="de">Entwicklung von Pokémon, die normalerweise einen Tausch erfordern</li>

      <li>Backup before any action - your data is safe</li>
      <li xml:lang="fr">Backup avant la moindre action - vos données sont sécurisées</li>
      <li xml:lang="de">Automatische Sicherung vor jeder Aktion - deine Daten sind geschützt</li>

      <li>Legality auto-check</li>
      <li xml:lang="fr">Vérifications de légalité</li>
      <li xml:lang="de">Automatische Überprüfung der Legalität</li>
    </ul>
  </description>

  <categories>
    <category>Utility</category>
    <category>Game</category>
  </categories>

  <keywords>
    <keyword>pokemon</keyword>
    <keyword>pkhex</keyword>
    <keyword>save</keyword>
    <keyword>storage</keyword>
    <keyword>editor</keyword>
    <keyword>collection</keyword>
  </keywords>

  <supports>
    <control>pointing</control>
    <control>gamepad</control>
    <control>keyboard</control>
    <control>touch</control>
  </supports>

  <requires>
    <!-- only desktop/tablet supported -->
    <display_length compare="ge">1279</display_length>
  </requires>

  <icon type="stock">io.github.chnapy.pkvault</icon>

  <branding>
    <color type="primary" scheme_preference="light">#C6836E</color>
    <color type="primary" scheme_preference="dark">#713425</color>
  </branding>

  <languages>
    <lang>en</lang>
    <lang>fr</lang>
    <lang>de</lang>
    <lang>pt_BR</lang>
  </languages>

  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/Chnapy/PKVault/v2.2.0/PKVault.Desktop/publishers/flatpak/snaps/snap_storage.png</image>
      <caption>Collection view</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/Chnapy/PKVault/v2.2.0/PKVault.Desktop/publishers/flatpak/snaps/snap_storage_dark.png</image>
      <caption>Dark mode</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/Chnapy/PKVault/v2.2.0/PKVault.Desktop/publishers/flatpak/snaps/snap_storage_details.png</image>
      <caption>Pokémon edit</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/Chnapy/PKVault/v2.2.0/PKVault.Desktop/publishers/flatpak/snaps/snap_dex.png</image>
      <caption>Pokédex</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/Chnapy/PKVault/v2.2.0/PKVault.Desktop/publishers/flatpak/snaps/snap_saves.png</image>
      <caption>Saves view</caption>
    </screenshot>
  </screenshots>

  <content_rating type="oars-1.1" />

  <url type="homepage">https://github.com/Chnapy/PKVault</url>
  <url type="vcs-browser">https://github.com/Chnapy/PKVault</url>
  <url type="bugtracker">https://github.com/Chnapy/PKVault/issues</url>
  <url type="translate">https://github.com/Chnapy/PKVault/issues/183</url>
  <url type="contribute">https://github.com/Chnapy/PKVault/blob/main/.github/CONTRIBUTING.md</url>
  <url type="donation">https://github.com/sponsors/Chnapy</url>
  
  <developer id="io.github.chnapy">
    <name>Richard Haddad</name>
    <url>https://github.com/Chnapy</url>
  </developer>

  <releases>
    <release version="2.2.0" date="2026-08-26">
      <url type="details">https://github.com/Chnapy/PKVault/releases/tag/v2.2.0</url>
      <description>
        <ul>
          <li>Add Traditional Chinese translations.</li>
          <li>Add saves files duplicates edit panel in saves page.</li>
          <li>Add saves sort option in saves-select panel.</li>
          <li>Redesign parts of settings page.</li>
          <li>Fix crash on some systems with Nvidia GPU.</li>
          <li>Fix crash because of github timeouts.</li>
          <li>Fix unselect after multiple releases.</li>
          <li>Fix multiple variants release.</li>
          <li>Fix some illegalities post-convert (version, ribbons, EVs).</li>
          <li>Fix "Species incompatible" error after move action to some saves.</li>
          <li>Fix Pokédex visual glitch after move action.</li>
          <li>Fix in fresh-start action to save, appeared on 2.1.2.</li>
        </ul>
      </description>
    </release>
    <release version="2.1.2" date="2026-08-18">
      <url type="details">https://github.com/Chnapy/PKVault/releases/tag/v2.1.2</url>
      <description>
        <ul>
          <li>Update app logo.</li>
          <li>Fix crash when run from Steam as non-Steam game.</li>
          <li>Detect language on first launch.</li>
          <li>Fix empty Pokédex when no save.</li>
          <li>Fix Japanese G1 games being not available.</li>
        </ul>
      </description>
    </release>
    <release version="2.1.1" date="2026-08-14">
      <url type="details">https://github.com/Chnapy/PKVault/releases/tag/v2.1.1</url>
      <description>
        <p>First release on Flathub.</p>
      </description>
    </release>
  </releases>
</component>
