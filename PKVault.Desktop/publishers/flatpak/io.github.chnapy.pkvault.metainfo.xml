<?xml version="1.0" encoding="utf-8"?>
<component type="desktop-application">
  <id>io.github.chnapy.pkvault</id>

  <!-- old ID used locally before flathub publish -->
  <replaces>
    <id>org.chnapy.pkvault</id>
  </replaces>
  <provides>
    <id>org.chnapy.pkvault</id>
  </provides>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <launchable type="desktop-id">io.github.chnapy.pkvault.desktop</launchable>

  <name>PKVault</name>
  <name xml:lang="fr">PKVault</name>
  <name xml:lang="de">PKVault</name>

  <summary>Pokémon hub for your games</summary>
  <summary xml:lang="fr">Hub Pokémon pour vos jeux</summary>
  <summary xml:lang="de">Pokémon-Zentrale für deine Spiele</summary>

  <description>
    <p>
      Centralize all your Pokémon games in one place.
      Manage storages between your saves, and group all Pokédex data.
    </p>
    <ul>
      <li>Compatible with all generations, from first one to Pokémon Legends: Z-A</li>
      <li>Safely convert pokémons to any generation</li>
      <li>Edit pokémons nickname, moves and EVs</li>
      <li>Evolve pokémons requiring trade</li>
      <li>Backup before any action - your data is safe</li>
      <li>Legality auto-check</li>
    </ul>

    <p xml:lang="fr">
      Regroupez tous vos jeux Pokémon au même endroit.
      Gérez les stockages entre vos sauvegardes, et centralisez les données Pokédex.
    </p>
    <ul xml:lang="fr">
      <li>Compatible avec toutes les générations, de la première à Pokémon Legends: Z-A</li>
      <li>Convertissez les pokémons vers n'importe quelle génération, sans perte de donnée</li>
      <li>Modifiez les pokémons: surnom, capacités et EVs</li>
      <li>Evoluez les pokémons exigeant un échange</li>
      <li>Backup avant la moindre action - vos données sont sécurisées</li>
      <li>Vérifications de légalité</li>
    </ul>

    <p xml:lang="de">
      Führe all deine Pokémon-Spiele an einem Ort zusammen.
      Verwalte deine Speicherstände und führe alle Pokédex-Daten zusammen.
    </p>
    <ul xml:lang="de">
      <li>Kompatibel mit allen Generationen, von der ersten bis zu Pokémon-Legenden: Z-A</li>
      <li>Sichere Übertragung von Pokémon in jede beliebige Generation</li>
      <li>Bearbeitung von Spitznamen, Attacken und EVs</li>
      <li>Entwicklung von Pokémon, die normalerweise einen Tausch erfordern</li>
      <li>Automatische Sicherung vor jeder Aktion - deine Daten sind geschützt</li>
      <li>Automatische Überprüfung der Legalität</li>
    </ul>
  </description>

  <categories>
    <category>Utility</category>
    <category>Game</category>
  </categories>

  <keywords>
    <keyword>pokemon</keyword>
    <keyword>pkhex</keyword>
    <keyword>save</keyword>
    <keyword>storage</keyword>
    <keyword>editor</keyword>
    <keyword>collection</keyword>
  </keywords>

  <supports>
    <control>pointing</control>
    <control>gamepad</control>
    <control>keyboard</control>
    <control>touch</control>
  </supports>

  <requires>
    <!-- only desktop/tablet supported -->
    <display_length compare="ge">1279</display_length>
  </requires>

  <icon type="stock">io.github.chnapy.pkvault</icon>

  <branding>
    <color type="primary" scheme_preference="light">#C6836E</color>
    <color type="primary" scheme_preference="dark">#713425</color>
  </branding>

  <languages>
